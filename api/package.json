{
  "name": "held-heard-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute held-heard-db --file=src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute held-heard-db --file=src/db/schema.sql --local",
    "db:seed:local": "wrangler d1 execute held-heard-db --file=src/db/seed.sql --local"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^4.20250327.0"
  }
}
